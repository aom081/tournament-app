# Server
PORT=4000
NODE_ENV=development

# Database (PostgreSQL via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tournament_db?schema=public"

# CORS
CORS_ORIGIN="http://localhost:5173"

# Auth
# In production this MUST be set explicitly (the app refuses to boot
# with NODE_ENV=production and no JWT_SECRET). In development/test a
# fallback is used automatically so the app runs without extra setup.
JWT_SECRET="dev-insecure-secret-change-me"
JWT_EXPIRES_IN="1h"
