# Frontend URL (local, Vercel, or another test deployment)
PLAYWRIGHT_BASE_URL=http://127.0.0.1:5173

# Set to 1 only if you want Playwright to start the app with `npm run dev`
# and the app can be started from the repository root.
PLAYWRIGHT_START_LOCAL=0

# Test accounts only — never use production credentials.
PLAYWRIGHT_ORGANIZER_EMAIL=
PLAYWRIGHT_ORGANIZER_PASSWORD=
PLAYWRIGHT_COMPETITOR_EMAIL=
PLAYWRIGHT_COMPETITOR_PASSWORD=

# Optional stable UI selectors. Add matching data-testid attributes to the app
# or update tests/helpers.ts to match the actual app UI.
PLAYWRIGHT_LOGIN_PATH=/login
PLAYWRIGHT_DASHBOARD_PATH=/
